# ==============================================================================
# Rocketlane Integration Credentials
# ==============================================================================
# API key used to authenticate HTTP requests against the Rocketlane REST API
ROCKETLANE_API_KEY=your_rocketlane_api_key_here
# Base URL for the Rocketlane REST API endpoints
ROCKETLANE_BASE_URL=https://api.rocketlane.com/api/1.0
# Toggle to switch between mock/sandbox responses and real Rocketlane API calls for testing
ROCKETLANE_MOCK_MODE=True
# Account owner email address used for Rocketlane project assignment
ROCKETLANE_OWNER_EMAIL=your_email@domain.com
# Rocketlane onboarding template IDs
ROCKETLANE_ENTERPRISE_TEMPLATE_ID=5000000095997
ROCKETLANE_GROWTH_TEMPLATE_ID=5000000096288

# ==============================================================================
# Voice AI Telephony Configuration
# ==============================================================================
# API key for the chosen Voice AI provider (e.g. Bland.ai, Vapi, Retell)
VOICE_AI_API_KEY=your_voice_ai_key_here
# Name of the provider used to dispatch the outbound AE tier confirmation call
VOICE_AI_PROVIDER=vapi
VOICE_AI_AGENT_ID=your_agent_id_here
# Default simulated tier for unattended testing & poller: ENTERPRISE (30-day template) or GROWTH (14-day template)
VOICE_AI_SIMULATED_TIER=ENTERPRISE

# ==============================================================================
# Slack Integration Configuration
# ==============================================================================
# Bot user OAuth token used to create customer channels and send welcome messages
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# Flag to enable mock mode for Slack API calls to prevent requiring live workspace permissions
SLACK_MOCK_MODE=True

# ==============================================================================
# Gmail Inbound Integration Configuration (CS Team Inbox)
# ==============================================================================
# Email address representing the CS team inbox where AEs send deal notifications
GMAIL_USER=rhuthvik8@gmail.com
# Google App Password (16-character token from Google Account > Security > 2-Step Verification)
GMAIL_APP_PASSWORD=your_gmail_app_password_here
# Polling interval in seconds for checking unread deal notification emails
GMAIL_POLL_INTERVAL=15
# Subject line keyword to filter deal notification emails (e.g. 'New Deal')
GMAIL_SUBJECT_FILTER=New Deal

# ==============================================================================
# System & Audit Logging Configuration
# ==============================================================================
# Target file path where all structured audit logs (JSON lines) will be appended
AUDIT_LOG_FILE_PATH=logs/audit_trail.jsonl
# Application log level (DEBUG, INFO, WARNING, ERROR) controlling console output detail
LOG_LEVEL=INFO
